<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="DdoItemTracker.Views.CopyGroupsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:DdoItemTracker.Presentation.ViewModels;assembly=DdoItemTracker.Presentation"
    x:DataType="vm:MyItemsViewModel">

    <CollectionView x:Name="List" ItemsSource="{Binding Groups}" IsGrouped="True" SelectionMode="Single" SelectionChanged="OnSelected">
        <CollectionView.GroupHeaderTemplate>
            <DataTemplate x:DataType="vm:CopyGroup">
                <Label Text="{Binding Title}" Style="{StaticResource SectionHeader}" Padding="4,8,4,4" />
            </DataTemplate>
        </CollectionView.GroupHeaderTemplate>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:MyItemRow">
                <VerticalStackLayout Padding="4,6">
                    <Label Text="{Binding ItemName}" FontSize="16" />
                    <Label Text="{Binding Subtitle}" Style="{StaticResource Secondary}" />
                    <Label Text="{Binding Note}" Style="{StaticResource Secondary}" IsVisible="{Binding HasNote}" FontAttributes="Italic" />
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
            <Label Text="No items match these filters." HorizontalOptions="Center" Margin="0,24" />
        </CollectionView.EmptyView>
    </CollectionView>
</ContentView>
