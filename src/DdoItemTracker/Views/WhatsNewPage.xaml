<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DdoItemTracker.Views.WhatsNewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="What's New">
    <VerticalStackLayout Padding="24" Spacing="16" MaximumWidthRequest="600" VerticalOptions="Center">
        <Label x:Name="HeaderLabel" FontSize="22" FontAttributes="Bold" TextColor="{DynamicResource GoldAccent}" />
        <Label Text="First release. Browse every named item, tap I have one to record it, and see set bonuses at a glance. Recording the server or character is optional." />
        <Label Text="Want to say where a copy is held? Add your characters in Settings, or import them from a DDO Life Tracker backup." />
        <Button Text="Got it" Clicked="OnDismissClicked" />
    </VerticalStackLayout>
</ContentPage>
