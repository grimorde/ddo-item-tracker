<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DdoItemTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DdoItemTracker.Views"
    xmlns:icons="clr-namespace:DdoItemTracker.Helpers"
    Title="DDO Item Tracker">

    <TabBar>
        <ShellContent
            Title="Catalog"
            Route="catalog"
            Icon="{FontImageSource FontFamily=IconSet, Glyph={x:Static icons:FontAwesomeIcons.BookOpen}, Size=20}"
            ContentTemplate="{DataTemplate views:CatalogPage}" />
        <ShellContent
            Title="My Items"
            Route="myitems"
            Icon="{FontImageSource FontFamily=IconSet, Glyph={x:Static icons:FontAwesomeIcons.BoxArchive}, Size=20}"
            ContentTemplate="{DataTemplate views:MyItemsPage}" />
    </TabBar>

</Shell>
